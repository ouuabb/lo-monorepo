{
  "id": "demo-hello",
  "name": "Demo Hello",
  "version": "0.1.0",
  "description": "最小 Demo 插件：加载后调用 Host 能力获取仓库状态，并声明扩展点",
  "author": "lo",
  "main": "index.cjs",
  "ui": "ui/index.mjs",
  "permissions": {
    "lo": ["health.read", "operations.write"],
    "storage": false,
    "network": false,
    "shell": false
  },
  "config": {
    "greeting": {
      "type": "string",
      "default": "Hello from demo plugin",
      "description": "插件问候语"
    }
  },
  "contributes": {
    "commands": [
      { "id": "demo-hello.hello", "title": "Demo: Hello" }
    ],
    "views": [
      { "id": "demo-hello.status", "title": "Demo: 状态", "type": "panel" }
    ],
    "panels": [
      { "id": "demo-hello.side", "title": "Demo: 侧栏" }
    ],
    "editors": [
      { "id": "demo-hello.editor", "title": "Demo: 笔记编辑器", "resourceType": "note" }
    ],
    "services": [
      { "id": "demo-hello.status-service", "title": "Demo: 状态服务" }
    ]
  }
}
