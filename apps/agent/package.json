{
  "name": "lo-agent",
  "version": "0.1.0",
  "description": "lo Agent 桌面端（Electron + 客户端插件宿主）",
  "main": "src/main/index.cjs",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "cross-env ELECTRON_RENDERER_URL=http://localhost:5173 electron .",
    "build": "vite build",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests",
    "lint": "eslint \"src/**/*.{cjs,mjs,jsx}\" \"test/**/*.cjs\"",
    "format": "prettier --write \"src/**/*.{cjs,mjs,jsx}\" \"test/**/*.cjs\""
  },
  "keywords": [
    "lo",
    "agent",
    "electron",
    "knowledge-base"
  ],
  "author": "lo Project",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src/",
    "README.md"
  ],
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "electron": "^33.4.11",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@lo/agent-plugins-sdk": "workspace:*",
    "@lo/client": "workspace:*",
    "d3": "^7.9.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tar": "^7.5.22"
  }
}
